// Parametric Sturdy Enclosure — Generated by 3D Model Studio
$fn = 64;
outer_width = 100.0;
outer_depth = 70.0;
outer_height = 35.0;
wall_thickness = 2.4;
floor_thickness = 2.4;
corner_radius = 5.0;
boss_outer_d = 8.1;
boss_hole_d = 4.1;
lip_height = 2.4;
lip_thickness = 1.2;

module rounded_box(w, d, h, r) {
    linear_extrude(height = h)
    offset(r = r)
    square([w - 2*r, d - 2*r], center = true);
}

difference() {
    union() {
        rounded_box(outer_width, outer_depth, outer_height, corner_radius);
    }
    // Inner cavity
    translate([0, 0, floor_thickness])
        rounded_box(outer_width - 2*wall_thickness, outer_depth - 2*wall_thickness, outer_height, max(1, corner_radius - wall_thickness));
    // Outer rabbet step for lid
    if (lip_height > 0) {
        translate([0, 0, outer_height - lip_height])
        difference() {
            rounded_box(outer_width + 2, outer_depth + 2, lip_height + 1, corner_radius);
            rounded_box(outer_width - 2*(wall_thickness - lip_thickness), outer_depth - 2*(wall_thickness - lip_thickness), lip_height + 2, max(1, corner_radius - (wall_thickness - lip_thickness)));
        }
    }
}
// Internal corner screw bosses
for (sx = [-1, 1], sy = [-1, 1]) {
    translate([sx * (42.750), sy * (27.750), floor_thickness])
    difference() {
        cylinder(d = boss_outer_d, h = outer_height - lip_height - floor_thickness);
        translate([0, 0, -0.1])
            cylinder(d = boss_hole_d, h = outer_height);
    }
}
