// Heavy-Duty Reinforced Structural L-Bracket — Generated by 3D Model Studio
$fn = 64;
flange_a = 60.0;
flange_b = 60.0;
width = 40.0;
thickness = 5.0;
fillet_r = 6.0;
gusset_t = 8.0;
gusset_len = 34.0;
hole_d = 4.5;

difference() {
    union() {
        // Flange A & B with inner root fillet
        linear_extrude(height = width)
        polygon(points = [
            [0, 0], [flange_a, 0], [flange_a, thickness],
            [thickness + fillet_r, thickness], [thickness, thickness + fillet_r],
            [thickness, flange_b], [0, flange_b]
        ]);
        // Central Structural Gusset Rib
        translate([0, 0, (width - gusset_t)/2])
        linear_extrude(height = gusset_t)
        polygon(points = [
            [thickness, thickness],
            [thickness + gusset_len, thickness],
            [thickness, thickness + gusset_len]
        ]);
    }
}
